# Supabase Configuration
# The project API origin. Everything the app builds off it follows it, including
# signed storage URLs — so if a custom domain is ever activated for the project,
# switch this deliberately (docs/supabase-custom-domain.md), not casually.
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google SSO (Optional)
# Canonical public origin used to build OAuth redirect URLs (the /auth/callback
# return). Set in PRODUCTION so redirects land on the real domain; leave unset
# locally to fall back to the request origin. The callback does NOT trust the
# x-forwarded-host header.
# NEXT_PUBLIC_SITE_URL=https://www.speddy.xyz
#
# Optional Google Workspace domain HINT (the `hd` param) — only pre-selects the
# Google account chooser toward one domain. It is NOT a security boundary; the
# provisioning gate in app/auth/callback is what blocks any account we haven't
# created. Leave unset for multi-district deployments.
# See docs/auth-google-sso.md for enablement steps.
# NEXT_PUBLIC_GOOGLE_HD=yourdistrict.org

# Google Calendar Integration (IEP meeting scheduling — SPE-205, Optional)
# OAuth client of type "Web application" in the Speddy Google Cloud project
# (Google Auth Platform → Clients) — SEPARATE from the Supabase sign-in client,
# because Speddy holds these refresh tokens itself. Register the redirect URI
# <origin>/api/calendar/google/callback for every origin used (production
# domain + http://localhost:3000 for local dev). Feature is dormant when
# unset: the connect UI reports "not set up on this server".
# GOOGLE_CALENDAR_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CALENDAR_CLIENT_SECRET=your-client-secret
# App-layer AES-256-GCM key for OAuth tokens at rest (32 bytes, base64):
# openssl rand -base64 32
# CALENDAR_TOKEN_ENCRYPTION_KEY=your-base64-32-byte-key

# SIS Integration (Aeries / OneRoster)
# App-layer AES-256-GCM key for district SIS credentials at rest (32 bytes,
# base64): openssl rand -base64 32
# Deliberately SEPARATE from CALENDAR_TOKEN_ENCRYPTION_KEY — these protect
# different data classes with different blast radii, and either must be
# rotatable without touching the other. Required before any district can
# submit SIS credentials; credential intake fails closed without it.
# SIS_CREDENTIAL_ENCRYPTION_KEY=your-base64-32-byte-key

# AI Services (Optional)
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# AI Feature Kill-Switch
# Master switch for all AI features (lesson / exit-ticket / progress-check /
# worksheet generation and AI document upload). Disabled by default: gated AI
# routes return 404 and make NO external LLM/provider calls unless this is 'true'.
AI_FEATURES_ENABLED=false

# Ask AI assistant (SPE-450/452)
# Per-feature switch: enables ONLY the provider assistant route
# (/api/assistant/chat) while the master switch above stays off. The master
# switch, when 'true', also enables the assistant. Requires ANTHROPIC_API_KEY.
# Optional: ASSISTANT_MODEL overrides the assistant's model (default claude-haiku-4-5).
ASSISTANT_ENABLED=false

# AI Privacy and Security (Optional)
# WARNING: These flags control storage of sensitive data including prompts and responses
# Only enable for debugging purposes in non-production environments
# Default is false (prompts and raw responses are NOT captured)
CAPTURE_FULL_PROMPTS=false  # Set to 'true' to capture full prompts (with PII redaction)
CAPTURE_AI_RAW=false        # Set to 'true' to capture raw AI responses (with PII redaction)

# Email Service (Optional)
# Resend powers the inbound email -> worksheet webhook only. That endpoint is
# DISABLED by default (EMAIL_WEBHOOK_ENABLED unset). Provider signature
# verification is NOT yet implemented and must be added before re-enabling
# (SPE-128); flipping the flag alone would accept unauthenticated POSTs. No
# other code path sends email; Supabase Auth handles signup/password-reset emails.
RESEND_API_KEY=your-resend-api-key
# EMAIL_WEBHOOK_ENABLED=false  # Re-enabling REQUIRES provider signature verification first (SPE-128)

# Cron Job Configuration
# Generate a secure token: openssl rand -base64 32
CRON_SECRET=your-long-random-secret-here

# Optional: Enable analytics cleanup (default: false)
# Set to 'true' to clean up analytics events older than 90 days
CLEANUP_ANALYTICS=false

# Monitoring — Sentry (all optional)
#
# The DSN for the `speddy` project is committed as a default in
# lib/monitoring/sentry-options.ts (a DSN is a public identifier, not a secret —
# it ships in the browser bundle), so error reporting works with none of these
# set. Override them only to point an environment at a different project.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Trace sampling, 0 to 1. Defaults to 1.0 in local development only; every
# deployed environment (production AND preview) defaults to 0.1, because preview
# runs against real data and traces carry resource-ID-bearing URL paths (SPE-216).
# Set to 0 to disable tracing and keep Sentry to exception capture only —
# next.config.js mirrors this value into the browser bundle, so this one setting
# covers server, edge and client. Errors are always captured regardless.
SENTRY_TRACES_SAMPLE_RATE=

# Build-time only: required by next.config.js to upload source maps, which is
# what turns minified production stack traces back into readable file/line
# numbers. Create at https://chicken-scratch-backend.sentry.io/settings/auth-tokens/
# Without it the build still succeeds — it just skips the upload.
SENTRY_AUTH_TOKEN=

# Aeries SIS Integration (Optional, server-only)
# Native Aeries REST API (v5) connection for importing schools/teachers/students.
# Per-district: each district issues its own 32-char read-only vendor certificate
# and has its own base URL. The certificate is a SERVER-SIDE SECRET and must never
# reach the browser — all Aeries calls are server-to-server.
# Leave BOTH unset to fall back to the public, read-only Aeries demo instance
# (https://demo.aeries.net) for local development. See docs/integrations/aeries.md.
# AERIES_BASE_URL=https://yourdistrict.aeries.net/aeries/api/v5
# AERIES_CERTIFICATE=your-32-char-vendor-certificate

# Environment
NODE_ENV=development